# Vorlage für .env (die echte .env wird nicht nach GitHub hochgeladen)
# Token: Home Assistant → Profil (unten links) → Sicherheit → Langlebige Zugangstoken → Token erstellen
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
# Optional: feste ID der Dashboard-Resource (sonst wird sie am Inhalt erkannt)
HA_RESOURCE_ID=
